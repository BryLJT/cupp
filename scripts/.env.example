# Python harness environment — copy to scripts/.env and fill in (never commit .env)
# Everything in this file is SECRET. It stays on your machine only.

# Supabase project (Storage upload + signed URLs)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role key: bypasses all security rules. Harness-only. NEVER in the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Vision model (OpenAI-compatible). Defaults target Agnes; swap all three to use OpenAI.
AI_BASE_URL=https://apihub.agnes-ai.com/v1
AI_MODEL=agnes-2.0-flash
AI_API_KEY=your-agnes-or-openai-key-here
