# Cupp app environment — copy to .env and fill in real values (never commit .env)
#
# NOTHING HERE IS REQUIRED. With no .env at all the app boots in DEMO MODE:
# in-memory fixtures, no network, full happy path. That is the default and the
# insurance policy if conference Wi-Fi dies on demo day.
#
# These two are SAFE to ship in the app bundle: the anon key only permits what
# our Supabase row-level-security rules allow. Set BOTH to leave demo mode.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Force demo mode ON even when the Supabase vars above are present.
# Unset/absent = demo mode is decided by whether those vars exist.
EXPO_PUBLIC_DEMO=1

# Scan pipeline. Absent/0 = the MOCK scan (staged delays + the validated SEY
# Huila extraction) — this is the default path. Set to 1 to call the real
# 'scan-bag' Edge Function instead. The Edge Function is Block 3 scope and does
# not exist yet, so leaving this unset is correct for now.
EXPO_PUBLIC_SCAN_LIVE=0

# NOTE: the Agnes/OpenAI key is NOT used by the app and must never appear here.
# It lives only in scripts/.env (server-side harness) and later in a Supabase
# Edge Function secret.
